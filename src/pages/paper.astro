---
import { withBase } from '@lib/url';
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const entry = await getEntry('paper', 'vphilox');
if (!entry) throw new Error('paper/vphilox.mdx missing — run scripts/convert-paper.sh');
const { Content } = await render(entry);

---

<Base title={entry.data.title}>
  <header class="paper-head">
    <h1 class="paper-title">{entry.data.title}</h1>
    <p class="byline">{entry.data.author}</p>
    <p class="paper-links">
      <a href={withBase("vphilox.pdf")}>Download PDF</a> ·
      <a href="https://github.com/sinhaparth5/vphilox">Source and data</a> ·
      <a href="https://doi.org/10.5281/zenodo.22103483">doi:10.5281/zenodo.22103483</a>
    </p>
  </header>
  <Content />
</Base>

<style>
  .paper-head { margin-bottom: 3rem; }
  .paper-title {
    font-size: var(--step-4);
    line-height: 1.12;
    margin: 0 0 0.6rem;
  }
  .byline { margin: 0 0 0.3rem; color: var(--text-soft); }
  .paper-links {
    font-family: var(--font-head), system-ui, sans-serif;
    font-size: var(--step--1);
    color: var(--text-faint);
    margin: 0;
  }
</style>

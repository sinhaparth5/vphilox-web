<style>
  /* Chrome, stage fading and wire tracing come from src/styles/anim.css.
     What is left here is the vocabulary specific to this drawing. */

  /* The natural width of the drawing; below it the canvas pans. */
  svg { min-width: 900px; }

  /* The figure has no card of its own, so the fills carry the depth. Things
     that hold state sit a shade above the paper; the substrate they share --
     the port block, the L3, the memory below it -- sits a shade under it. */
  .core rect { fill: none; stroke: var(--rule-mid); stroke-width: 1.6; }
  .thread rect { fill: var(--bg-raised); stroke: var(--rule-mid); stroke-width: 1.4; }
  .ports rect { fill: var(--bg-sunk); stroke: none; }
  .port rect { fill: var(--bg-raised); stroke: var(--text-faint); stroke-width: 1.3; }
  .cache rect { fill: var(--bg-raised); stroke: var(--rule-mid); stroke-width: 1.4; }
  .cache.shared rect, .cache.dram rect { fill: var(--bg-sunk); stroke: var(--rule-mid); }

  /* Outlines laid over the shapes they emphasise, so the labels show through. */
  .overlay rect { fill: none; }
  .overlay.hot rect { stroke: var(--accent); stroke-width: 2.4; }
  .overlay.cool rect { stroke: var(--link); stroke-width: 2.4; }
  .wire.hot { stroke: var(--accent); stroke-width: 2.2; }
  .divider { stroke: var(--rule); stroke-width: 1; fill: none; }

  /* Workers sit outside the stages: the two placements replace one another
     rather than accumulating, so the arm on screen is driven by an attribute
     the stepper sets rather than by stage order. */
  .workers {
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
  }
  [data-arm='spread'] .workers.spread,
  [data-arm='packed'] .workers.packed { opacity: 1; }
  .worker rect { fill: var(--text); }
  /* Three classes, so this outranks the shared `.anim .box text` fill. */
  .worker .wklabel, .workers .wklabel { fill: var(--bg-raised); }

  .bar rect { fill: var(--text-faint); }
  .bar.bar-hi rect { fill: var(--accent); }
  .panelcap { fill: var(--text-faint); text-anchor: start; }
  .rowlab { fill: var(--text-faint); text-anchor: end; }
  .val { fill: var(--text); text-anchor: start; }
  .delta { fill: var(--accent); text-anchor: start; font-weight: 600; }

  @media (prefers-reduced-motion: reduce) {
    .workers { transition: none; }
  }
</style>

<script>
  import { mountStepper, type Step } from '@lib/stepper';

  const STEPS: Step[] = [
    ['The part', 'An Intel Core i5-11300H. Four physical cores, two hardware threads each, 32 KiB of instruction cache and 48 KiB of data cache per core, 1.25 MiB of L2 per core, 8 MiB of L3 across all four. Turbo is off for every run on this host, so the timestamp counter ticks at the base clock and cycles per byte is a true core-cycle count.'],
    ['One per core', 'Four workers, one to a physical core. Each has a core’s issue ports and its own caches to itself. The identical job costs 0.5160 cycles per byte.'],
    ['Packed onto siblings', 'The same four workers on two cores, two to a core, with cores 2 and 3 left idle. Same binary, same disjoint counter ranges, and the instruction count per byte agrees to six decimal places between the two arms. It costs 0.8204 cycles per byte: 59% more for identical work.'],
    ['Where the time goes', 'Both threads of a core issue into one set of execution ports, and Philox spends its time in the multiply ports specifically. Two hardware threads on one core do not have two cores’ worth of issue capacity, so the second worker waits. The same 35% per-worker penalty shows up on an unrelated 16-core Cascade Lake part.'],
    ['Not the instruction cache', 'Siblings share the L1 instruction cache too, which makes instruction supply the competing explanation. It moves the wrong way. Misses per thousand instructions fall by 36% while cost rises by 59%, because both threads run the same loop and the second finds the code already resident. That leaves port contention standing.'],
  ];

  mountStepper('[data-cpu]', STEPS, {
    autoplayMs: 3400,
    onRender: (root, at) => {
      root.dataset.arm = at === 0 ? 'none' : at === 1 ? 'spread' : 'packed';
    },
  });
</script>

    <button class="icon-btn" type="button" data-play aria-label="Play the sequence">
      <svg class="i-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
      <svg class="i-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
    </button>
    <ol class="anim-steps" role="tablist" aria-label="Placement stages">
      <li><button type="button" role="tab" data-step="0">The part</button></li>
      <li><button type="button" role="tab" data-step="1">One per core</button></li>
      <li><button type="button" role="tab" data-step="2">Packed</button></li>
      <li><button type="button" role="tab" data-step="3">The ports</button></li>
      <li><button type="button" role="tab" data-step="4">Not the cache</button></li>
    </ol>
  </div>
  <div class="anim-progress"><span data-progress></span></div>

